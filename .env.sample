# qwengine configuration. Copy to .env and edit if you need to.
#
# Where the model lives. Either:
#   a Hugging Face repo id  -- downloaded on first run
#   or a local directory    -- used as-is
#
# unsloth/Qwen3.8-27B-NVFP4 is the smaller download (22 GB) and the default.
# Qwen/Qwen3.8-27B is the BF16 release: 56 GB, and gives slightly better
# quality because nothing is quantised twice.
MODEL=unsloth/Qwen3.8-27B-NVFP4

# Where the converted engine file goes (~17 GB).
WEIGHTS=./out/qwengine.bin

PORT=8000

# Context length. KV cache is about 0.5 MB per token per 1k of context.
CTX=8192

# Speculative draft depth. 4 is the measured optimum on a DGX Spark:
# depth 3 accepts 2.2 tokens per cycle and depth 4 accepts 2.6, which more
# than pays for the wider verify pass. Depth 6 accepts no more than 5.
# 1 turns speculation off.
DEPTH=4

# Set to 1 to build without the vision tower (saves 0.9 GB, text only).
NO_VISION=0
